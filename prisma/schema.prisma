  inventoryItem   InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  title           String
  reference       String?
  category        String?
  brand           String?
  compatibleModels String[]           @default([])
  quality         String?
  condition       String              @default("NEW")
  quantity        Int                 @default(1)
  reservedQuantity Int                @default(0)
  unitPrice       Decimal             @db.Decimal(12,3)
  imageDataUrl    String?
  notes           String?
  region          String?
  status          MarketListingStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  requests        PartMarketRequest[]
  sosResponses    SosPartResponse[]

  @@index([status, createdAt])
  @@index([sellerShopId, status])
  @@index([region, status])
  @@index([reference])
}

model PartMarketRequest {
  id          String              @id @default(cuid())
  listingId   String
  listing     PartMarketListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerShopId String
  buyerShop   Shop                @relation("MarketBuyerShop", fields: [buyerShopId], references: [id], onDelete: Cascade)
  buyerUserId String
  buyerUser   User                @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  quantity    Int
  offeredPrice Decimal?           @db.Decimal(12,3)
  message     String?
  status      MarketRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([listingId, status])
  @@index([buyerShopId, status])
}

model SosPartRequest {
  id            String        @id @default(cuid())
  requesterShopId String
  requesterShop Shop          @relation("SosRequesterShop", fields: [requesterShopId], references: [id], onDelete: Cascade)
  requesterUserId String
  requesterUser User          @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  partName      String
  reference     String?
  deviceModel   String?
  quantity      Int           @default(1)
  regionOnly    Boolean       @default(true)
  region        String?
  urgencyNote   String?
  status        SosPartStatus @default(OPEN)
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  responses     SosPartResponse[]

  @@index([status, region, createdAt])
  @@index([requesterShopId, status])
}

model SosPartResponse {
  id            String            @id @default(cuid())
  requestId     String
  request       SosPartRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responderShopId String
  responderShop Shop              @relation("SosResponderShop", fields: [responderShopId], references: [id], onDelete: Cascade)
  responderUserId String
  responderUser User              @relation(fields: [responderUserId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       PartMarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  quantityAvailable Int
  price         Decimal?          @db.Decimal(12,3)
  message       String?
  status        SosResponseStatus @default(OFFERED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([requestId, status])
  @@index([responderShopId, status])
}

model ExpertCallRequest {
