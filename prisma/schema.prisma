generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTION
  TECHNICIAN
  CASHIER
}

enum RepairStatus {
  RECEIVED
  DIAGNOSIS
  IN_REPAIR
  WAITING_PART
  READY
  DELIVERED
  CANCELLED
}

enum RepairPriority {
  NORMAL
  URGENT
}

enum DeviceCategory {
  PHONE
  TABLET
  COMPUTER
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  D17
  FLOUCI
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum WarrantyClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
}

enum AttachmentType {
  BEFORE
  AFTER
  DOCUMENT
  SIGNATURE_RECEPTION
  SIGNATURE_DELIVERY
}

enum DocumentType {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  STOCK
  REPAIR
  PAYMENT
  WARRANTY
  SYSTEM
}

enum AdPlacement {
  QUEUE
  TRACK
  LANDING
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum AdMediaType {
  IMAGE
  ANIMATED_IMAGE
  VIDEO
}

enum BroadcastAudience {
  SHOP
  REGION
  PLAN
  ALL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_SHOP
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RewardReason {
  TOP_SHOP
  MANUAL
  REFERRAL
  PROMOTION
}

enum ChangelogVisibility {
  ALL
  STARTER
  PRO
  BUSINESS
}

enum AutomationTrigger {
  REPAIR_CREATED
  REPAIR_READY
  READY_OVERDUE
  LOW_STOCK
  QUOTE_APPROVED
  QUOTE_REJECTED
  WARRANTY_EXPIRING
  CASH_DIFFERENCE
}

enum AutomationAction {
  NOTIFICATION
  WHATSAPP_SUGGESTION
  ASSIGN_TECHNICIAN
  CREATE_TASK
}

enum GoalType {
  REVENUE
  REPAIRS
  PROFIT
  SATISFACTION
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  KONNECT
  MANUAL
  CUSTOM
}

enum MessageChannel {
  IN_APP
  WHATSAPP
  PUSH
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SupplierOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SupplierDeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum AdBillingModel {
  FLAT
  CPM
  CPC
}

enum AdReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SaasPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum CompatibilityConfidence {
  VERIFIED
  COMMUNITY
  POSSIBLE
}

enum CommunityScope {
  GLOBAL
  REGION
  SPECIALTY
}

enum CommunityPostType {
  CHAT
  FAULT
  SOLUTION
  COMPATIBILITY
  ALERT
}

enum CommunityKnowledgeStatus {
  DISCUSSION
  PROPOSED
  CONFIRMED
  VERIFIED
  REJECTED
}

enum CommunityVoteType {
  USEFUL
  CONFIRM
}


enum MarketListingStatus {
  ACTIVE
  RESERVED
  SOLD
  PAUSED
  CLOSED
}

enum MarketRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SosPartStatus {
  OPEN
  FOUND
  CLOSED
  EXPIRED
}

enum SosResponseStatus {
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ExpertCallStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum AcademyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CareSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DigitalWarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  shops         Shop[]
  subscriptions Subscription[]
  saasPayments  SaasPayment[]
  saasInvoices  SaasInvoice[]
  subscriptionRequests SubscriptionRequest[]
}

model Shop {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String   @unique
  region                String   @default("Non classée")
  city                  String?
  address               String?
  phone                 String?
  whatsappPhone         String?
  email                 String?
  website               String?
  latitude              Decimal? @db.Decimal(10,7)
  longitude             Decimal? @db.Decimal(10,7)
  publicVisible         Boolean  @default(false)
  publicFeatured        Boolean  @default(false)
  publicDescription     String?
  publicServices        String[] @default([])
  coverDataUrl          String?
  openingHours          Json?
  taxId                 String?
  countryCode           String   @default("216")
  currency              String   @default("DT")
  locale                String   @default("fr-TN")
  logoDataUrl           String?
  footerText            String   @default("Merci pour votre confiance")
  whatsappReceived      String   @default("Bonjour {client}, votre appareil {device} a bien été reçu. Code : {code}.")
  whatsappReady         String   @default("Bonjour {client}, votre appareil {device} est prêt. Montant restant : {balance} {currency}.")
  queueShowClient       Boolean  @default(false)
  invoicePrefix         String   @default("FAC")
  quotePrefix           String   @default("DEV")
  defaultTaxRate        Decimal  @default(0) @db.Decimal(5,2)
  warrantyReminderDays  Int      @default(7)
  lowStockNotifications Boolean  @default(true)
  cashRequireSession    Boolean  @default(false)
  smartMarginTarget     Decimal  @default(30) @db.Decimal(5,2)
  readyReminderHours    Int      @default(72)
  googleReviewUrl       String?
  loyaltyEnabled        Boolean  @default(true)
  qualityRequiredBeforeReady Boolean @default(true)
  automationsEnabled    Boolean  @default(true)
  cashierMaxDiscount    Decimal  @default(100) @db.Decimal(12,3)
  cashierManagerApprovalAbove Decimal @default(10) @db.Decimal(12,3)
  deliveryRequiresFullPayment Boolean @default(true)
  whatsappCloudEnabled  Boolean  @default(false)
  whatsappPhoneNumberId String?
  whatsappBusinessAccountId String?
  whatsappAccessTokenEncrypted String?
  konnectEnabled        Boolean  @default(false)
  konnectWalletId       String?
  konnectApiKeyEncrypted String?
  konnectSandbox        Boolean  @default(true)
  pushEnabled           Boolean  @default(true)
  aiExternalEnabled     Boolean  @default(false)
  aiBaseUrl             String?
  aiModel               String?
  aiApiKeyEncrypted     String?
  setupCompletedAt      DateTime?
  isActive               Boolean  @default(true)
  lastSeenAt             DateTime?
  lastLoginAt            DateTime?
  platformNotes          String?
  createdAt              DateTime @default(now())
  users                 User[]
  clients               Client[]
  repairs               Repair[]
  payments              Payment[]
  inventory             InventoryItem[]
  suppliers             Supplier[]
  purchases             Purchase[]
  expenses              Expense[]
  repairTypes           RepairType[]
  auditLogs             AuditLog[]
  warrantyClaims        WarrantyClaim[]
  cashSessions          CashSession[]
  stockMovements        StockMovement[]
  attachments           RepairAttachment[]
  notifications         Notification[]
  salesDocuments        SalesDocument[]
  platformMessages      PlatformMessage[]
  supportTickets        SupportTicket[]
  rewards               ShopReward[]
  adImpressions         AdImpression[]
  automationRules       AutomationRule[]
  automationRuns        AutomationRun[]
  qualityChecks         RepairQualityCheck[]
  feedbacks             ClientFeedback[]
  goals                 ShopGoal[]
  appointments          Appointment[]
  paymentLinks          PaymentLink[]
  pushSubscriptions     PushSubscription[]
  messageLogs           MessageLog[]
  supplierMarketplaceOrders SupplierOrder[]
  subscriptionRequests SubscriptionRequest[]
  communityPosts       CommunityPost[]
  communityVotes       CommunityVote[]
  marketListings       PartMarketListing[] @relation("ListingSellerShop")
  marketPurchaseRequests PartMarketRequest[] @relation("MarketBuyerShop")
  sosPartRequests       SosPartRequest[] @relation("SosRequesterShop")
  sosPartResponses      SosPartResponse[] @relation("SosResponderShop")
  expertRequests        ExpertCallRequest[] @relation("ExpertRequesterShop")
  expertAcceptedCalls   ExpertCallRequest[] @relation("ExpertAcceptedShop")
  expertMessages        ExpertCallMessage[]
  academyCourses        AcademyCourse[]
  carePlans             CarePlan[]
  careSubscriptions     ClientCareSubscription[]
  digitalWarranties     DigitalWarranty[]

  @@index([tenantId])
  @@index([region])
  @@index([city])
  @@index([publicVisible, region])
  @@index([lastSeenAt])
}

model User {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fullName           String
  loginCode          String
  phone              String?
  email              String?
  role               UserRole
  pinHash            String
  isActive           Boolean  @default(true)
  mustChangePin      Boolean  @default(false)
  technicianSpecialties String[] @default([])
  lastSeenAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  assignedRepairs    Repair[] @relation("TechnicianRepairs")
  statusEvents       RepairStatusEvent[]
  payments           Payment[] @relation("PaymentUser")
  auditLogs          AuditLog[]
  claimsCreated      WarrantyClaim[] @relation("ClaimCreator")
  claimsResolved     WarrantyClaim[] @relation("ClaimResolver")
  cashSessionsOpened CashSession[] @relation("CashOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashClosedBy")
  stockMovements     StockMovement[]
  attachments        RepairAttachment[]
  notifications      Notification[]
  supportMessages    SupportMessage[]
  qualityChecks      RepairQualityCheck[]
  pushSubscriptions  PushSubscription[]
  documentPayments    DocumentPayment[]
  communityPosts      CommunityPost[]
  communityVotes      CommunityVote[]
  marketListings       PartMarketListing[]
  marketPurchaseRequests PartMarketRequest[]
  sosPartRequests       SosPartRequest[]
  sosPartResponses      SosPartResponse[]
  expertRequests        ExpertCallRequest[] @relation("ExpertRequesterUser")
  expertAcceptedCalls   ExpertCallRequest[] @relation("ExpertAcceptedUser")
  expertMessages        ExpertCallMessage[]
  academyProgress       AcademyLessonProgress[]

  @@unique([shopId, loginCode])
  @@index([shopId, role])
}

model Client {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String
  email          String?
  notes          String?
  loyaltyPoints  Int      @default(0)
  walletToken    String?  @unique @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  repairs        Repair[]
  salesDocuments SalesDocument[]
  feedbacks      ClientFeedback[]
  appointments   Appointment[]
  messageLogs     MessageLog[]
  careSubscriptions ClientCareSubscription[]
  digitalWarranties DigitalWarranty[]

  @@unique([shopId, phone])
  @@index([shopId, fullName])
}

model Repair {
  id                String         @id @default(cuid())
  shopId            String
  shop              Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code              String
  publicToken       String         @unique @default(cuid())
  offlineRequestId  String?        @unique
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category          DeviceCategory
  brand             String?
  model             String
  serialNumber      String?
  color             String?
  lockCodeEncrypted String?
  reportedIssue     String
  diagnosis         String?
  internalNotes     String?
  priority          RepairPriority @default(NORMAL)
  status            RepairStatus   @default(RECEIVED)
  technicianId      String?
  technician        User?          @relation("TechnicianRepairs", fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedPrice    Decimal?       @db.Decimal(12,3)
  finalPrice        Decimal?       @db.Decimal(12,3)
  discountAmount    Decimal        @default(0) @db.Decimal(12,3)
  discountReason    String?
  discountApprovedBy String?
  warrantyDays      Int            @default(30)
  promisedAt        DateTime?
  estimatedMinutes  Int?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  parts             RepairPart[]
  payments          Payment[]
  statusEvents      RepairStatusEvent[]
  warrantyClaims    WarrantyClaim[]
  attachments       RepairAttachment[]
  salesDocuments    SalesDocument[]
  qualityChecks     RepairQualityCheck[]
  feedback          ClientFeedback?
  automationRuns    AutomationRun[]
  paymentLinks      PaymentLink[]
  messageLogs       MessageLog[]
  digitalWarranty  DigitalWarranty?

  @@unique([shopId, code])
  @@index([shopId, status])
  @@index([shopId, technicianId])
  @@index([clientId])
  @@index([shopId, deliveredAt])
}

model RepairStatusEvent {
  id         String       @id @default(cuid())
  repairId   String
  repair     Repair       @relation(fields: [repairId], references: [id], onDelete: Cascade)
  fromStatus RepairStatus?
  toStatus   RepairStatus
  note       String?
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  @@index([repairId, createdAt])
}

model InventoryItem {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  category        String?
  quantity        Int      @default(0)
  minQuantity     Int      @default(0)
  purchasePrice   Decimal  @default(0) @db.Decimal(12,3)
  salePrice       Decimal  @default(0) @db.Decimal(12,3)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  repairParts     RepairPart[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]
  compatibilities PartCompatibility[]
  marketListings  PartMarketListing[]
  @@unique([shopId, sku])
  @@index([shopId, name])
}

model RepairPart {
  id              String         @id @default(cuid())
  repairId        String
  repair          Repair         @relation(fields: [repairId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Int            @default(1)
  unitCost        Decimal        @db.Decimal(12,3)
  unitPrice       Decimal        @db.Decimal(12,3)
  createdAt       DateTime       @default(now())
  @@index([repairId])
}

model Payment {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairId       String
  repair         Repair        @relation(fields: [repairId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?         @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  cashSessionId  String?
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  kind           PaymentKind   @default(PAYMENT)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12,3)
  receivedAmount Decimal?      @db.Decimal(12,3)
  changeAmount   Decimal?      @db.Decimal(12,3)
  externalReference String?
  paymentLinkId  String?
  paymentLink    PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime      @default(now())
  @@index([shopId, createdAt])
  @@index([repairId])
  @@index([cashSessionId])
}

model Supplier {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  items     InventoryItem[]
  purchases Purchase[]
  @@index([shopId, name])
}

model Purchase {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reference  String
  status     PurchaseStatus @default(DRAFT)
  total      Decimal        @default(0) @db.Decimal(12,3)
  notes      String?
  createdAt  DateTime       @default(now())
  receivedAt DateTime?
  items      PurchaseItem[]
  @@unique([shopId, reference])
  @@index([shopId, createdAt])
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int
  unitCost        Decimal       @db.Decimal(12,3)
}

model Expense {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  category      String
  label         String
  amount        Decimal      @db.Decimal(12,3)
  note          String?
  expenseDate   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  @@index([shopId, expenseDate])
  @@index([cashSessionId])
}

model RepairType {
  id           String         @id @default(cuid())
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  category     DeviceCategory
  fixedPrice   Decimal?       @db.Decimal(12,3)
  isFixedPrice Boolean        @default(false)
  active       Boolean        @default(true)
  @@index([shopId, category])
}

model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
}

model WarrantyClaim {
  id           String              @id @default(cuid())
  shopId       String
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairId     String
  repair       Repair              @relation(fields: [repairId], references: [id], onDelete: Cascade)
  status       WarrantyClaimStatus @default(OPEN)
  issue        String
  resolution   String?
  createdById  String?
  createdBy    User?               @relation("ClaimCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedById String?
  resolvedBy   User?               @relation("ClaimResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  @@index([shopId, status])
  @@index([repairId])
}

model CashSession {
  id             String            @id @default(cuid())
  shopId         String
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  openedById     String
  openedBy       User              @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById     String?
  closedBy       User?             @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @default(0) @db.Decimal(12,3)
  expectedCash   Decimal?          @db.Decimal(12,3)
  closingActual  Decimal?          @db.Decimal(12,3)
  difference     Decimal?          @db.Decimal(12,3)
  note           String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  payments       Payment[]
  expenses       Expense[]
  @@index([shopId, status])
  @@index([shopId, openedAt])
}

model StockMovement {
  id              String            @id @default(cuid())
  shopId          String
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            StockMovementType
  quantityChange  Int
  quantityAfter   Int
  unitCost        Decimal?          @db.Decimal(12,3)
  reference       String?
  note            String?
  createdAt       DateTime          @default(now())
  @@index([shopId, createdAt])
  @@index([inventoryItemId, createdAt])
}

model RepairAttachment {
  id           String         @id @default(cuid())
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  repairId     String
  repair       Repair         @relation(fields: [repairId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  type         AttachmentType
  fileName     String
  mimeType     String
  url          String
  sizeBytes    Int?
  createdAt    DateTime       @default(now())
  @@index([repairId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  @@index([shopId, createdAt])
  @@index([userId, readAt])
}

model SalesDocument {
  id            String         @id @default(cuid())
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  repairId      String?
  repair        Repair?        @relation(fields: [repairId], references: [id], onDelete: SetNull)
  type          DocumentType
  status        DocumentStatus @default(DRAFT)
  number        String
  sourceQuoteId String?
  publicToken   String?        @unique
  clientDecisionAt DateTime?
  clientDecisionNote String?
  subtotal      Decimal        @default(0) @db.Decimal(12,3)
  discount      Decimal        @default(0) @db.Decimal(12,3)
  taxRate       Decimal        @default(0) @db.Decimal(5,2)
  taxAmount     Decimal        @default(0) @db.Decimal(12,3)
  total         Decimal        @default(0) @db.Decimal(12,3)
  notes         String?
  validUntil    DateTime?
