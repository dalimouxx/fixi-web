{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIXI Caisse Windows",
  "version": "0.1.0",
  "identifier": "net.fixi.caisse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FIXI Caisse Pro — Prototype Windows",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}