# ===== Fixi sur VPS — copiez ce fichier en .env et remplissez =====
FIXI_DOMAIN=fixi.mon-domaine.tn
NEXT_PUBLIC_APP_URL=https://fixi.mon-domaine.tn
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long

# Secrets (générez chacun avec : openssl rand -base64 32)
AUTH_SECRET=
PLATFORM_AUTH_SECRET=
SUPPLIER_AUTH_SECRET=
DELIVERY_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# Sauvegardes : phrase de chiffrement (NOTEZ-LA AILLEURS : sans elle, les sauvegardes sont illisibles)
BACKUP_PASSPHRASE=
# Copie hors du serveur (fortement conseillé) : nom du « remote » rclone, ex. gdrive:fixi-sauvegardes
BACKUP_REMOTE=

# Alertes sur votre téléphone (Telegram) : erreurs, sauvegarde manquante ou échouée
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ou n'importe quel webhook (Discord, Slack, n8n…)
ALERT_WEBHOOK_URL=

# Premier démarrage
INITIAL_SHOP_SLUG=atelier-principal
INITIAL_SHOP_NAME=Mon Atelier
INITIAL_SHOP_REGION=Gabès
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PIN=
PLATFORM_ADMIN_LOGIN=platform
PLATFORM_ADMIN_PASSWORD=
