# ===== Fixi sur VPS — NE REMPLISSEZ PAS À LA MAIN : lancez  ./make-env.sh votre-domaine.tn  =====
# (le script crée .env avec tous les secrets déjà générés). Ce fichier explique chaque ligne.

# Votre nom de domaine (enregistrement A chez Hostinger vers l'IP du VPS) et l'adresse complète en https.
# TOUS les QR codes, étiquettes, liens de suivi et messages WhatsApp utilisent NEXT_PUBLIC_APP_URL.
FIXI_DOMAIN=fixi.mon-domaine.tn
NEXT_PUBLIC_APP_URL=https://fixi.mon-domaine.tn

# Mot de passe de la base : lettres et chiffres uniquement (un « / » ou un « + » casserait l'adresse de la base)
POSTGRES_PASSWORD=

# Secrets (générés par make-env.sh avec : openssl rand -base64 32)
AUTH_SECRET=
PLATFORM_AUTH_SECRET=
SUPPLIER_AUTH_SECRET=
DELIVERY_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# Compte Fixi Control (super admin). Créé au premier démarrage, jamais modifié ensuite par ce fichier.
# Pour le changer plus tard : ./reset-control-password.sh
PLATFORM_ADMIN_LOGIN=platform
PLATFORM_ADMIN_PASSWORD=

# Sauvegardes : phrase de chiffrement (NOTEZ-LA AILLEURS : sans elle, les sauvegardes sont illisibles)
BACKUP_PASSPHRASE=
# Copie hors du serveur (fortement conseillé) : nom du « remote » rclone, ex. gdrive:fixi-sauvegardes
BACKUP_REMOTE=

# Alertes sur votre téléphone (Telegram) : erreurs, sauvegarde manquante, mises à jour réussies ou annulées
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ou n'importe quel webhook (Discord, Slack, n8n…)
ALERT_WEBHOOK_URL=

# Notifications push (téléphones des gérants, livreurs, fournisseurs) : clés générées par make-env.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Caisse Windows : ventes, caisse, commandes, retours et encaissement des dettes sont ACTIVÉS par défaut.
# Mettre « false » pour en couper une (rarement utile).
FIXI_WINDOWS_SALES_ENABLED=true
FIXI_WINDOWS_ORDERS_ENABLED=true
FIXI_WINDOWS_RETURNS_ENABLED=true
FIXI_WINDOWS_DEBT_PAYMENTS_ENABLED=true

# Mises à jour automatiques depuis GitHub (voir deploy.sh)
DEPLOY_BRANCH=main
# Facultatif : ne mettre à jour que la nuit (heure de Tunis), ex. 01-06 = entre 01 h et 06 h. Vide = à tout moment.
DEPLOY_ONLY_BETWEEN=

# Application Android : empreinte SHA-256 de la clé de signature (affichée à la fin de la construction de l'APK).
# Sans elle, l'application Android affiche une barre d'adresse. Plusieurs empreintes : séparées par des virgules.
TWA_SHA256=
